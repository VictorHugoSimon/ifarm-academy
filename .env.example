# Front-end runtime. Nenhum secret deve usar prefixo VITE_.
VITE_API_BASE_URL=/api

# Boundary server-side temporário até integração definitiva com o iFarm Core.
# Nunca expor ao browser e nunca prefixar com VITE_.
ACADEMY_ADMIN_PROXY_SECRET=

# Integrações server-side permanecem sem valores até provisionamento exclusivo.
IFARM_CORE_API_URL=
IFARM_CORE_CLIENT_ID=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
VIDEO_PROVIDER=
