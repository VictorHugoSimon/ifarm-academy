# Front-end runtime. Variáveis VITE_ são públicas no bundle; nunca colocar secrets nelas.
VITE_API_BASE_URL=/api
VITE_NEON_AUTH_URL=

# Contrato executável atual do iFarm Core. A URL é server-side; a sessão do browser
# usa o Bearer Neon e a Academy valida identidade/tenant/permissões no Core.
ACADEMY_CORE_API_URL=
ACADEMY_CORE_REQUEST_TIMEOUT_MS=4000

# Secret interno do bridge Academy. Nunca expor ao browser.
# STAGE/PRODUCTION: deploy_cloudflare_pages.py gera e grava diretamente no Pages.
ACADEMY_ADMIN_PROXY_SECRET=

# Worker comercial interno. Também é gerado pelo deploy e nunca usa prefixo VITE_.
ACADEMY_COMMERCIAL_WORKER_SECRET=

# Worker interno de reconciliação financeira. Não reutilizar secret do worker comercial.
# O endpoint /api/payments/mercado-pago/reconcile permanece fail-closed sem este secret.
ACADEMY_PAYMENT_WORKER_SECRET=
ACADEMY_PAYMENT_RECONCILE_MAX_ATTEMPTS=8
ACADEMY_PAYMENT_RECONCILE_CLAIM_TTL_SECONDS=300
ACADEMY_PAYMENT_RECONCILE_BATCH_SIZE=10

# Operação/ambiente. Em STAGE/PRODUCTION, readiness exige Core, D1 e storage prontos.
ACADEMY_ENVIRONMENT=dev
# Em deploy real, ACADEMY_RELEASE recebe os 12 primeiros caracteres do Git SHA.
ACADEMY_RELEASE=local
ACADEMY_STORAGE_REQUIRED=false
ACADEMY_RATE_LIMIT_ENABLED=true

# AI Tutor provider boundary. Desligado por padrão.
# ACADEMY_TUTOR_PROVIDER_TOKEN é secret server-side: nunca usar prefixo VITE_ e nunca
# disponibilizar esse valor ao browser. gateway_v1 aceita apenas HTTPS (HTTP só localhost DEV).
ACADEMY_TUTOR_PROVIDER_MODE=disabled
ACADEMY_TUTOR_PROVIDER_URL=
ACADEMY_TUTOR_PROVIDER_TOKEN=
ACADEMY_TUTOR_PROVIDER_TIMEOUT_MS=6000
ACADEMY_TUTOR_PROVIDER_MAX_OUTPUT_CHARS=3500

# Payment provider boundary. v0.72 valida HMAC, consulta o recurso canônico e também possui
# reconciliação interna para falhas transitórias. O worker não cria cobrança externa.
ACADEMY_PAYMENT_PROVIDER=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_REQUEST_TIMEOUT_MS=5000

# Variáveis locais opcionais para smoke.
# Não cadastrar ACADEMY_STAGE_BEARER_TOKEN como variável pública VITE_.
ACADEMY_STAGE_URL=
ACADEMY_STAGE_EXPECTED_RELEASE=
ACADEMY_STAGE_BEARER_TOKEN=

# GitHub Actions / Cloudflare — usar secrets exclusivos do repositório ifarm-academy.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Integrações futuras permanecem sem valores até homologação própria.
VIDEO_PROVIDER=
