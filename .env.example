# Front-end runtime. Variáveis VITE_ são públicas no bundle; nunca colocar secrets nelas.
VITE_API_BASE_URL=/api
VITE_NEON_AUTH_URL=

# Contrato executável atual do iFarm Core. A URL é server-side; a sessão do browser
# usa o Bearer Neon e a Academy valida identidade/tenant/permissões no Core.
ACADEMY_CORE_API_URL=
ACADEMY_CORE_REQUEST_TIMEOUT_MS=4000

# Secret interno do bridge Academy -> headers confiáveis. Nunca expor ao browser.
ACADEMY_ADMIN_PROXY_SECRET=

# Operação/ambiente. Em STAGE/PRODUCTION, readiness exige ACADEMY_CORE_API_URL válida.
ACADEMY_ENVIRONMENT=dev
ACADEMY_RELEASE=0.52.0
ACADEMY_STORAGE_REQUIRED=false

# Variáveis locais opcionais para `npm run stage:smoke`.
# Não cadastrar ACADEMY_STAGE_BEARER_TOKEN como variável pública VITE_.
ACADEMY_STAGE_URL=
ACADEMY_STAGE_EXPECTED_RELEASE=0.52.0
ACADEMY_STAGE_BEARER_TOKEN=

# Integrações server-side permanecem sem valores até provisionamento exclusivo.
IFARM_CORE_API_URL=
IFARM_CORE_CLIENT_ID=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
VIDEO_PROVIDER=
